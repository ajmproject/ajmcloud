# ==============================================================================
# AjmCloud API — Environment Configuration Example
# Salin file ini menjadi .env.local untuk development lokal.
# JANGAN PERNAH menyimpan kredensial atau rahasia asli di repositori ini.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3001

# Supabase Configuration (Wajib untuk database, auth, dan RLS)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only

# Google OAuth 2.0 Credentials (untuk menghubungkan Google Drive)
# Dapatkan dari Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/drive/callback

# Token Encryption Secret (AES-256-GCM)
# 32-byte hex string (64 characters) untuk mengenkripsi token Google di database
TOKEN_ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Client Origin / CORS (URL aplikasi mobile dan admin)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
